NODE_ENV=development
DATABASE_URL=mysql://backoffice:change-me@127.0.0.1:3307/backoffice
BACKOFFICE_SESSION_SECRET=replace-with-a-long-random-secret
NATIONAL_ID_ENCRYPTION_KEY=replace-with-64-hex-characters
NATIONAL_ID_LOOKUP_KEY=replace-with-a-different-64-hex-characters
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=backoffice-attachments
S3_ACCESS_KEY_ID=local-s3-access
S3_SECRET_ACCESS_KEY=local-s3-secret-development-only
CLAMD_HOST=clamav
CLAMD_PORT=3310
# การแจ้งเตือน LINE (docs/runbooks/line-alert.md). Leave empty to keep LINE off.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
BACKOFFICE_PUBLIC_URL=
# Public host for LINE's webhook when the hospital NATs a public IP here (node scripts/setup-local.mjs line-webhook).
LINE_WEBHOOK_HOST=
