NODE_ENV=development
DATABASE_URL=mysql://backoffice:change-me@127.0.0.1:3307/backoffice
BACKOFFICE_SESSION_SECRET=replace-with-a-long-random-secret
NATIONAL_ID_ENCRYPTION_KEY=replace-with-64-hex-characters
NATIONAL_ID_LOOKUP_KEY=replace-with-a-different-64-hex-characters
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=backoffice-attachments
S3_ACCESS_KEY_ID=local-s3-access
S3_SECRET_ACCESS_KEY=local-s3-secret-development-only
CLAMD_HOST=clamav
CLAMD_PORT=3310
# การแจ้งเตือน LINE (docs/runbooks/line-alert.md). Leave empty to keep LINE off.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
BACKOFFICE_PUBLIC_URL=
# Public host for LINE's webhook when the hospital NATs a public IP here (node scripts/setup-local.mjs line-webhook).
LINE_WEBHOOK_HOST=
# Host ports for that door when 80/443 are already taken on this machine; point the NAT at them.
# LINE_WEBHOOK_HTTP_PORT=8081
# LINE_WEBHOOK_HTTPS_PORT=8444
# วันหยุดจาก HOSxP (read-only SELECT on `holiday`). Settings saved under ผู้ดูแลระบบ → ตั้งค่าการเชื่อมต่อ win;
# HOSXP_DATABASE_URL is the fallback when none are saved. Use a read-only HOSxP account.
HOSXP_DATABASE_URL=
# 64 hex characters (openssl rand -hex 32): seals connection passwords saved from the admin screen.
CONNECTION_SECRET_KEY=
# HOLIDAY_SYNC_INTERVAL_MS=86400000
