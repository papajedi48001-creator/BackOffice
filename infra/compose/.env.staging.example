# Copy this file to /etc/backoffice/staging.env. Keep the copy outside Git.
# Every *_FILE value must point to an operator-controlled secret file, mode 0600.
COMPOSE_PROJECT_NAME=waritch-backoffice-staging
PUBLIC_HOSTNAME=backoffice-stg.example.internal
STAGING_WEB_PORT=3100
# Allocated after confirming it does not overlap hospital network ranges.
BACKOFFICE_BACKPLANE_SUBNET=10.250.251.0/24
BACKOFFICE_STORAGE_SUBNET=10.250.252.0/24
BACKOFFICE_SCAN_SUBNET=10.250.253.0/24
BACKOFFICE_UPDATES_SUBNET=10.250.254.0/24
WEB_IMAGE=registry.example.internal/waritch-backoffice/web:replace-with-release-tag
WORKER_IMAGE=registry.example.internal/waritch-backoffice/worker:replace-with-release-tag
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:8.4-alpine
SEAWEEDFS_IMAGE=registry.example.internal/waritch-backoffice/seaweedfs:replace-with-approved-digest
CLAMAV_IMAGE=registry.example.internal/waritch-backoffice/clamav:replace-with-approved-digest
CADDY_IMAGE=caddy:2.10-alpine
DATABASE_URL_FILE=/etc/backoffice/secrets/database_url
BACKOFFICE_SESSION_SECRET_FILE=/etc/backoffice/secrets/session_secret
NATIONAL_ID_ENCRYPTION_KEY_FILE=/etc/backoffice/secrets/national_id_encryption_key
NATIONAL_ID_LOOKUP_KEY_FILE=/etc/backoffice/secrets/national_id_lookup_key
MARIADB_ROOT_PASSWORD_FILE=/etc/backoffice/secrets/mariadb_root_password
MARIADB_PASSWORD_FILE=/etc/backoffice/secrets/mariadb_password
S3_ACCESS_KEY_ID_FILE=/etc/backoffice/secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=/etc/backoffice/secrets/s3_secret_access_key
SEAWEEDFS_S3_CONFIG_FILE=/etc/backoffice/secrets/seaweedfs_s3.json
BACKUP_ENCRYPTION_KEY_FILE=/etc/backoffice/secrets/backup_encryption_key
MARIADB_DATABASE=backoffice
MARIADB_USER=backoffice
S3_BUCKET=backoffice-attachments
BACKUP_RETENTION_DAYS=REPLACE_WITH_APPROVED_RETENTION_DAYS
BACKUP_DIR=/var/backups/waritch-backoffice
