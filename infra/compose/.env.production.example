# Copy this file to an operator-controlled location (for example /etc/backoffice/production.env).
# Do not commit the copy. Every *_FILE value must point to a root-readable secret file.
COMPOSE_PROJECT_NAME=waritch-backoffice-production
PUBLIC_HOSTNAME=backoffice.example.internal
WEB_IMAGE=registry.example.internal/waritch-backoffice/web:replace-with-release-tag
WORKER_IMAGE=registry.example.internal/waritch-backoffice/worker:replace-with-release-tag
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:8.4-alpine
MINIO_IMAGE=registry.example.internal/waritch-backoffice/minio:replace-with-approved-digest
CADDY_IMAGE=caddy:2.10-alpine
DATABASE_URL_FILE=/etc/backoffice/secrets/database_url
BACKOFFICE_SESSION_SECRET_FILE=/etc/backoffice/secrets/session_secret
MARIADB_ROOT_PASSWORD_FILE=/etc/backoffice/secrets/mariadb_root_password
MARIADB_PASSWORD_FILE=/etc/backoffice/secrets/mariadb_password
MINIO_ROOT_USER_FILE=/etc/backoffice/secrets/minio_root_user
MINIO_ROOT_PASSWORD_FILE=/etc/backoffice/secrets/minio_root_password
BACKUP_ENCRYPTION_KEY_FILE=/etc/backoffice/secrets/backup_encryption_key
MARIADB_DATABASE=backoffice
MARIADB_USER=backoffice
S3_BUCKET=backoffice-attachments
BACKUP_RETENTION_DAYS=REPLACE_WITH_APPROVED_RETENTION_DAYS
BACKUP_DIR=/var/backups/waritch-backoffice
